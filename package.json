{
  "name": "petal-workspace",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8766",
    "build": "node build-validator.cjs && next build && node scripts/prepare-package.mjs && esbuild lib/store.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/store.mjs && esbuild lib/vault.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/vault.mjs",
    "start": "next start --hostname 127.0.0.1 --port 8766",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate": "node validate.cjs",
    "format": "prettier --write",
    "build:validator": "node build-validator.cjs",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "description": "Local-first task and progress tracker for Claude Code, OpenAI Codex, and OpenCode. Multi-project dashboard, agent skills, JSON storage, and optional Git sync.",
  "bin": {
    "petal": "bin/petal.mjs"
  },
  "license": "MIT",
  "files": [
    "app",
    "components",
    "lib",
    "dist",
    "bin",
    "skills",
    "icons",
    "tracker.schema.json",
    "tracker-validator.js",
    "next.config.ts",
    ".next/server",
    ".next/static",
    ".next/BUILD_ID",
    ".next/routes-manifest.json",
    ".next/prerender-manifest.json",
    ".next/build-manifest.json",
    ".next/app-build-manifest.json",
    ".next/required-server-files.json",
    ".next/package.json",
    "README.md",
    "LICENSE",
    "scripts/verify-package.mjs",
    ".next/app-path-routes-manifest.json",
    ".next/images-manifest.json",
    ".next/fallback-build-manifest.json",
    ".next/export-marker.json",
    ".next/required-server-files.js",
    "scripts/prepare-package.mjs",
    "scripts/smoke-package.mjs",
    "scripts/npm-command.mjs"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "openai-codex",
    "opencode",
    "ai-agents",
    "agent-skills",
    "task-manager",
    "progress-tracker",
    "local-first",
    "git",
    "json",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckysolanki902/petal.git"
  },
  "homepage": "https://github.com/luckysolanki902/petal#readme",
  "bugs": {
    "url": "https://github.com/luckysolanki902/petal/issues"
  }
}
